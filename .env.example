# ==========================================================
# SGN Hospital, Jalna - Environment Configuration
# Copy this file to .env and fill in the real values.
# ==========================================================

# ---------- Application ----------
APP_ENV=development
# Host ports for Docker. Pick ports not used by other hospitals on the server.
WEB_PORT=3111
DB_HOST_PORT=3112
TZ=Asia/Calcutta

# ---------- Database ----------
# Development (XAMPP)
DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_PORT=3306

# Production (Docker) - swap the values above with these
# DB_HOST=db
# DB_NAME=sgn_hospital
# DB_USER=sgn_user
# DB_PASSWORD=your_production_password
DB_ROOT_PASSWORD=change_me

# ---------- Hospital / Branding ----------
HOSPITAL_SOCIETY=
HOSPITAL_NAME=SGN HOSPITAL
HOSPITAL_LOCATION=Jalna
HOSPITAL_MAIL=
HOSPITAL_PHONE=

# ---------- Pharmacy ----------
PHARMA_NAME=Pharmacy
PHARMA_LICENSE_NO=

# ---------- phpMyAdmin ----------
PMA_PORT=3113
PMA_UPLOAD_LIMIT=50M

# ---------- PHP ----------
PHP_MEMORY_LIMIT=256M
PHP_MAX_EXECUTION_TIME=300
PHP_UPLOAD_MAX_FILESIZE=50M
PHP_POST_MAX_SIZE=50M

# ============================================================
# ABDM / ABHA Integration
# Consumed by config/abdm_config.php, which defines the constants
# used by createAabha.php, abha_integration.php and abha_link_patient.php.
# ============================================================

# Node gateway that fronts ABDM (all ABHA calls go through it).
ABDM_BASE_URL=https://abdm-api.nexenstial.com
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
# HIP id as ABDM issues it (the HRP service registered against the facility),
# NOT the bare facility id from the NHA email.
ABDM_HIP_ID=
# X-CM-ID. Sandbox is "sbx"; the production Consent Manager id is "abdm".
ABDM_CM_ID=abdm

# HIU id (Milestone 3). Blank = same facility as ABDM_HIP_ID.
ABDM_HIU_ID=
# Scope of an HIU record fetch. off (default) = consent names ABDM_HIP_ID, so a
# fetch returns only this hospital's records. on = every HIP the patient linked.
ABDM_HIU_FETCH_ALL_HIPS=off
ABDM_REQUESTER_SYSTEM=https://www.nmc.org.in
ABDM_REQUESTER_DEFAULT_REGNO=

# Automatic care-context linking on clinical events. off = clinical saves no
# longer request a link token. Manual linking via createAabha.php is unaffected.
ABDM_AUTOLINK=on

# Gateway callback URLs. Leave blank to auto-derive from ABDM_BASE_URL
# (…/api/milestone2/abdm-proxy/*) in config/abdm_config.php.
ABDM_ON_NOTIFY_URL=
ABDM_ON_REQUEST_URL=
ABDM_HI_NOTIFY_URL=
ABDM_ON_SHARE_URL=
ABDM_ON_RUNNING_TOKEN_STATUS_URL=
SCAN_SHARE_TOKEN_EXPIRY=1800
SCAN_SHARE_SELF_DECLARED_MODE=reject

# Base URL encoded in the facility QR (the patient's ABHA app opens it).
# Sandbox: https://phrsbx.abdm.gov.in/share-profile
# Production: https://phr.abdm.gov.in/share-profile
ABDM_SHARE_PROFILE_URL=https://phr.abdm.gov.in/share-profile

# ============================================================
# Local Services
# ============================================================
FIDELIUS_URL=http://localhost:8090
FHIR_ENDPOINT=http://localhost/sgn_jalna_hospital/api/fhir_records.php
# Base URL of this project's api/ directory (internal self-calls).
# Leave blank to auto-derive from FHIR_ENDPOINT.
HIMS_API_BASE_URL=

# ============================================================
# Application Encryption Key
# ============================================================
APP_ENC_KEY=

# ============================================================
# Security flags
# APP_DEBUG       : true exposes debug tools guarded by config/dev_guard.php.
#                   MUST be false in production.
# ABDM_VERIFY_SSL : verify TLS certs on outbound ABDM/gateway calls.
#                   Blank = on in production, off in development.
# ============================================================
APP_DEBUG=false
ABDM_VERIFY_SSL=

# Node gateway account used once per install to mint the X-API-Key that
# abha_integration.php sends. Leave blank to skip provisioning at login.
ABDM_GATEWAY_EMAIL=
ABDM_GATEWAY_PASSWORD=

# 
# Registration APIs (api/opd_registration.php, api/ipd_registration.php)
# REGISTRATION_API_KEY : required X-API-Key header value; blank disables the APIs.
# RETAILXPRESS_API_KEY : pharmacy customer sync for new OPD patients (rx_id); blank skips it.
# 
REGISTRATION_API_KEY=
RETAILXPRESS_API_KEY=
