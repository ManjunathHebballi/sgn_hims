# PHP Hospital Management System - Git Ignore File

# ===========================
# Sensitive Configuration Files
# ===========================
# Database configuration with credentials
config/*.php
# ABDM/ABHA config carries no secrets - every value comes from .env.
!config/abdm_config.php
!config/abdm_display.php
!config/env_loader.php
!config/dev_guard.php
# dbconnect.php
model/dbconnect.php
billing/model/dbconnect.php
model/session_config.php
.env
.env.local

